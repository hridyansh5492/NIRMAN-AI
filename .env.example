# ==============================================================================
# NirmanAI Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Supabase API & Project Credentials
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. LLM / AI Copilot (OpenRouter / Gemini)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0